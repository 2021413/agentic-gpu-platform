# ---------------------------------------------------------------------------
# Agentic GPU Platform - example environment
#
# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets; every value below is a
# placeholder safe for local development only.
#
# Keys in the section "SPECIFICATION CONTRACT" are the ones required by the
# specification (section 22). The other sections are additions that the local
# stack or the worker process needs in practice; keys flagged (proposed) are
# names chosen here while the application/infrastructure layers are still
# being written - confirm them against `bootstrap/` settings once it lands.
# ---------------------------------------------------------------------------


# ===========================================================================
# SPECIFICATION CONTRACT (spec section 22)
# ===========================================================================

# --- Persistence -----------------------------------------------------------
# Async SQLAlchemy URL for the durable store (projects, runs, plans, jobs,
# candidates, reviews, events). Must use the asyncpg driver.
# Inside Docker Compose the host is the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5432/agentic

# Redis connection URL: worker registry, heartbeat TTLs, job queue/streams,
# distributed locks, event fan-out. Never the only durable store for run state.
# Inside Docker Compose the host is the service name `redis`.
REDIS_URL=redis://localhost:6379/0

# --- Control plane API -----------------------------------------------------
# Interface the API binds to. 0.0.0.0 inside a container, 127.0.0.1 on a host
# you do not want to expose.
API_HOST=0.0.0.0

# TCP port of the control plane API.
API_PORT=8000

# Shared secret protecting the internal worker endpoints
# (/internal/workers/register, heartbeat, drain, ...). Both the control plane
# and every worker must present the same value.
# Generate a real one for anything beyond localhost:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=dev-service-token-change-me

# --- Worker identity -------------------------------------------------------
# Stable identifier of this worker (UUID). Leave empty to let the worker agent
# generate one at startup; set it explicitly when the worker must keep the same
# identity across restarts.
WORKER_ID=

# URL at which the CONTROL PLANE can reach this worker. It must be routable
# from the control plane, not from the worker itself: inside Compose that is
# the service name, on a remote GPU host it is its public/VPN address.
WORKER_ENDPOINT=http://worker-fake:9000

# --- Model -----------------------------------------------------------------
# Model served by this worker, advertised in its capabilities. Initial target
# is Qwen3-Coder-30B-A3B; it is deliberately not hard-coded anywhere in the
# code or in the Dockerfiles.
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Maximum context window of that model, in tokens. Used both to start the
# inference server and to reject prompts that cannot fit (Worker.can_accept).
MODEL_CONTEXT_LENGTH=131072

# How many jobs this worker accepts at once. Hard ceiling for the scheduler.
WORKER_CONCURRENCY=4

# --- Heartbeats ------------------------------------------------------------
# How often the worker agent sends a heartbeat to the control plane.
HEARTBEAT_INTERVAL_SECONDS=10

# Silence beyond this duration makes the control plane mark the worker
# unavailable and reclaim its in-flight jobs. Keep it a small multiple of
# HEARTBEAT_INTERVAL_SECONDS (3x-6x) to survive a transient network blip.
HEARTBEAT_TIMEOUT_SECONDS=45

# --- Inference and agentic budgets ----------------------------------------
# Timeout of a single LLM request. A 30B model generating a large patch is slow;
# this must stay well above the slowest expected completion.
LLM_REQUEST_TIMEOUT_SECONDS=600

# How many times a plan may be revised before the run fails.
MAX_PLAN_REVISIONS=2

# How many coder iterations are allowed on one candidate.
MAX_CODER_ITERATIONS=4

# How many repair loops (validation/review failure -> coder) are allowed.
MAX_REPAIR_ITERATIONS=3

# Upper bound on competing candidates executed in parallel for one task.
# The orchestrator may use fewer when the pool is smaller or the task is simple.
MAX_PARALLEL_CANDIDATES=3


# ===========================================================================
# RUNTIME / OPERATIONS (additions)
# ===========================================================================

# Deployment profile: local | ci | staging | production. Selects safe defaults
# (e.g. verbose errors only outside production). (proposed)
ENVIRONMENT=local

# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Log rendering: json for aggregation, console for a readable local terminal.
LOG_FORMAT=console

# Expose Prometheus metrics on the API. (proposed)
METRICS_ENABLED=true

# --- Job queue and leases (spec sections 12 and 36) ------------------------
# Lease duration granted when a worker claims a job. A worker must renew it
# while running; if it dies, the lease expires and the job is requeued.
# Must be longer than one inference step, shorter than a human's patience.
JOB_LEASE_SECONDS=120

# Attempts per job before it is marked DEAD (Job.max_attempts default is 3).
JOB_MAX_ATTEMPTS=3

# How often the control plane sweeps expired leases and stale workers. (proposed)
REAPER_INTERVAL_SECONDS=15

# Worker selection policy: least_loaded_compatible_worker | round_robin. Matches the schedulers
# implemented in domain/services/scheduling.py. (proposed)
SCHEDULER_STRATEGY=least_loaded_compatible_worker

# --- Workspaces and artifacts ---------------------------------------------
# Root under which isolated candidate workspaces are created. One directory per
# candidate; never the repository being edited. (proposed)
WORKSPACE_ROOT=/var/lib/agentic/workspaces

# Root of the artifact store (patches, logs, tool output). (proposed)
ARTIFACT_ROOT=/var/lib/agentic/artifacts


# ===========================================================================
# WORKER AGENT (the process running next to the GPU)
# ===========================================================================

# Control plane base URL used by the worker to register, heartbeat, drain and
# report job results. Inside Compose: http://api:8000
CONTROL_PLANE_URL=http://localhost:8000

# Inference backend used by this worker: vllm | openai_compatible | fake.
# `fake` is the deterministic local/CI adapter that needs no GPU. (proposed)
LLM_PROVIDER=fake

# OpenAI-compatible endpoint of the local inference server, known only to the
# worker. The orchestrator never sees it - it only knows WORKER_ENDPOINT.
# For the GPU worker this is the local vLLM server. (proposed)
#
# Give the server ROOT, with no /v1 suffix. InferenceProbe appends the paths
# it needs - /health, then /v1/models - so a /v1 here asks for /v1/health and
# /v1/v1/models instead. Both answer 404, and because the probe treats any
# non-success as "not ready yet" rather than an error, the damage is silent:
# the readiness gate never opens, and the reconciliation that corrects
# MODEL_ID and MODEL_CONTEXT_LENGTH against what the engine really serves
# never runs. Wrong:  http://127.0.0.1:8001/v1
INFERENCE_BASE_URL=http://127.0.0.1:8001

# API key presented to the local inference server. vLLM accepts any value
# unless it was started with --api-key. (proposed)
#
# Against a Modal Server this is the workspace proxy token, the token id and
# secret joined by a period: wk-<id>.ws-<secret>. Modal accepts that pair in
# exactly this Bearer header, so moving to Modal needs no new mechanism here.
#   modal workspace proxy-tokens create
INFERENCE_API_KEY=local

# Whether the inference endpoint is serverless and may have no worker running.
#
# Set it to true for a Modal Server, leave it false for a RunPod Pod. It changes
# what HTTP 503 means. A Modal Server does not queue: with an empty pool its
# proxy answers 503 at once and boots a container in response to that same
# request, so the status means "the GPU is starting" and the adapter waits for
# it. On a dedicated Pod the same status means something is broken.
#
# Leaving this false against Modal fails in a way that costs money rather than
# looking like a bug: every first request after an idle period fails, the job is
# requeued, and the retry runs on the container the failed job paid to start.
INFERENCE_SCALE_TO_ZERO=false

# How long a request may wait for a serverless worker to appear, in seconds.
# Separate from LLM_REQUEST_TIMEOUT_SECONDS because it measures a container
# booting rather than a model generating; it must cover a cold vLLM start.
INFERENCE_COLD_START_MAX_WAIT_SECONDS=900

# Roles this worker advertises, comma separated among PLANNER, CODER,
# REVIEWER. (proposed)
WORKER_ROLES=PLANNER,CODER,REVIEWER

# Port the worker agent listens on for control-plane callbacks/health.
# Must match the port inside WORKER_ENDPOINT. (proposed)
WORKER_PORT=9000

# Grace period given to a DRAINING worker to finish its jobs before it
# deregisters and exits. (proposed)
WORKER_DRAIN_TIMEOUT_SECONDS=300


# ===========================================================================
# GPU / vLLM WORKER ONLY (docker compose --profile gpu)
# ===========================================================================

# Port of the vLLM OpenAI-compatible server inside the worker container.
VLLM_PORT=8001

# Number of GPUs the model is sharded over (vLLM --tensor-parallel-size).
TENSOR_PARALLEL_SIZE=1

# Fraction of GPU memory vLLM may reserve (vLLM --gpu-memory-utilization).
GPU_MEMORY_UTILIZATION=0.90

# Extra flags appended verbatim to the vLLM server command, e.g.
# "--enable-auto-tool-choice --tool-call-parser hermes --quantization fp8".
VLLM_EXTRA_ARGS=

# Model cache INSIDE the container. Weights stay out of the image and live in
# the `hf-cache` named volume (or a host path) mounted here.
HF_HOME=/models/huggingface

# Token for gated/private Hugging Face repositories. Leave empty for public
# models. Treat as a secret: never commit a real token.
HUGGING_FACE_HUB_TOKEN=


# ===========================================================================
# REMOTE INFERENCE WORKER ONLY (docker compose --profile remote)
# ===========================================================================

# Base URL of the inference server that lives somewhere else - today a Modal
# Server, an HTTPS endpoint that scales to zero. The `worker-remote` agent
# runs here next to the control plane; only the model is remote.
#
# This one value is used twice, which is why the /v1 rule above is not a
# detail. It is the agent's INFERENCE_BASE_URL, probed at /health and
# /v1/models, and it is the WORKER_ENDPOINT the agent registers - and the
# control plane's adapter posts to <endpoint>/v1/chat/completions. A /v1 here
# therefore breaks readiness AND every completion the orchestrator sends.
# Give the root:  https://<workspace>--<app>-serve.modal.run
REMOTE_INFERENCE_URL=

# Against that endpoint, set INFERENCE_SCALE_TO_ZERO=true above. It is the
# control plane, not this worker, that must know: the api container holds the
# adapter that has to read a 503 as "the GPU is starting".


# ===========================================================================
# DOCKER COMPOSE ONLY (used to provision the local containers)
# ===========================================================================

# Absolute host path of the project the orchestrator edits. Bind-mounted into
# the api container at /projects/current by docker-compose.override.yml, which
# refuses to start without it: a project referenced by `local_path` has to be
# reachable from inside the container, not merely from your shell.
LOCAL_PROJECT_PATH=/absolute/path/to/your/project

# Credentials the `postgres` container is created with. They must stay
# consistent with DATABASE_URL above.
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic

# Host ports published by the local stack; change them if they are taken.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PUBLISHED_PORT=8000
