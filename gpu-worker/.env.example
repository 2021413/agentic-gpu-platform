# ===========================================================================
# Agentic GPU worker — runtime configuration.
#
# Copy to .env (never commit it) or paste these into the RunPod Pod template's
# environment variables. Everything here is read at boot by
# src/worker/config.py, which is the single source of truth: a value it does
# not know is a typo, and a value it cannot parse fails the boot immediately
# rather than half an hour into a download.
#
# Every line below shows the REAL default. Commented-out means "the default
# applies"; uncomment only to change it.
#
# Nothing in this file is a secret. The two secret variables are listed at the
# bottom with empty values on purpose.
# ===========================================================================


# ---------------------------------------------------------------------------
# MODEL
# ---------------------------------------------------------------------------

# Which repository to serve. 31.2 GB over 4 shards, FP8 e4m3 block-quantised,
# MoE with 128 experts, native context 262144.
# Default: Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
#MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8

# Pin the exact commit. Default: unset, which resolves `main` — whatever it
# points at on the day of the download.
# Strongly recommended in production: without a pin, two Pods started a month
# apart can serve different weights while reporting the same model name. Note
# that the marker on the volume matches ANY resident revision when this is
# unset, so a moving `main` does NOT trigger a re-download by itself.
# This image was built and validated against the revision below.
#MODEL_REVISION=dcaee4d4dfc5ee71ad501f01f530e5652438fde0

# The name clients must send as "model" in the OpenAI API payload, and the name
# readiness and the smoke test check for.
# Default: unset, i.e. MODEL_ID is used verbatim.
# Set it to keep client code stable across a model swap.
#SERVED_MODEL_NAME=qwen3-coder


# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------

# Where the RunPod network volume is mounted. Everything large lives under it:
# models/, huggingface/hub/, vllm/, torch/, tmp/, state/, logs/, xdg/.
# Default: /runpod-volume
# Must be absolute. The image also bakes HF_HOME, HF_HUB_CACHE,
# HUGGINGFACE_HUB_CACHE, VLLM_CACHE_ROOT, TORCH_HOME, TMPDIR, XDG_CACHE_HOME
# and TRITON_CACHE_DIR from this default — if you change it here, entrypoint.sh
# re-derives all of them before anything imports torch or huggingface_hub. Do
# not set those cache variables by hand; they are derived, not configured.
#PERSISTENT_ROOT=/runpod-volume

# Free space required before a COLD download is allowed to start, in GB.
# Default: 40
#
# Why 40 and not 32: the weights are 31.2 GB resident, and an interrupted
# download keeps its partial blobs so it can resume rather than restart, so it
# transiently needs room for the in-flight shard on top of what is already
# there. 40 GB covers weights plus roughly one shard.
#
# Why not more: this floor must stay BELOW what the volume can actually offer.
# A 60 GB volume presents about 58 GB free, so a floor of 60 would make every
# first boot fail on a volume that is perfectly adequate.
#
# RULE WHEN YOU CHANGE MODEL: set this to (weight size) + 10 GB, and size the
# volume to (weight size) + 25 GB. See docs/changing-the-model.md.
#
# A volume that ALREADY holds a verified snapshot is exempt: preflight enforces
# this only on a cold start, because nothing large is about to be written.
#MIN_FREE_DISK_GB=40

# Escape hatch: accept running without a mounted volume.
# Default: unset (i.e. a missing or non-mounted volume is fatal).
# Set to 1 ONLY for a throwaway experiment. The 31.2 GB then lands on the
# container filesystem, is re-downloaded on every Pod start, and can fill the
# host disk. It exists so that the refusal has a documented alternative, not
# because it is ever a good idea in production.
#WORKER_ALLOW_EPHEMERAL_STORAGE=1


# ---------------------------------------------------------------------------
# SERVICE
# ---------------------------------------------------------------------------

# Interface vLLM binds. Default: 0.0.0.0
# A container must bind every interface to be reachable through the Pod proxy.
#HOST=0.0.0.0

# Port for the OpenAI-compatible API. Default: 8000 (EXPOSEd by the image).
# Change it and you must also change the RunPod HTTP port mapping.
#PORT=8000

# Maximum sequence length, prompt plus completion, in tokens.
# Default: 16384
# The model supports 262144 natively, but the KV cache scales linearly with
# this number: raising it takes GPU memory away from batching and lowers
# throughput. Raise it deliberately, for a workload that needs it.
#MAX_MODEL_LEN=16384

# Fraction of each GPU's memory vLLM may use, in (0, 1]. Default: 0.90
# The remaining 10% covers the CUDA context, activations and fragmentation.
# Above ~0.95 a long prompt turns into a CUDA OOM at inference time rather than
# at startup, which is much harder to diagnose.
#GPU_MEMORY_UTILIZATION=0.90

# Extra vLLM flags, appended verbatim to the argument vector.
# Default: unset.
# Parsed with shlex at config time: quoting is honoured, but nothing is
# expanded — no globbing, no command substitution, no variable expansion. This
# is a list of words, never a shell fragment.
#VLLM_EXTRA_ARGS=--enable-prefix-caching --disable-log-requests


# ---------------------------------------------------------------------------
# TIMINGS
# ---------------------------------------------------------------------------

# How long `worker-ready` waits for the server to serve the expected model.
# Default: 1800 (30 minutes)
# Covers weight loading, torch.compile and CUDA graph capture on a cold cache,
# not the download — preparation happens before vLLM is started.
#READINESS_TIMEOUT_SECONDS=1800

# Interval between readiness polls, in seconds. Default: 3
#READINESS_POLL_SECONDS=3

# How many times a failed download is resumed before giving up. Default: 5
# Each attempt resumes from the partial blobs; it never starts over. A full
# disk is NOT retried — retrying would fill the same disk, slower.
#MODEL_DOWNLOAD_MAX_ATTEMPTS=5

# Base backoff between download attempts, in seconds; doubles each time.
# Default: 5  (so 5, 10, 20, 40 ...)
#MODEL_DOWNLOAD_BACKOFF_SECONDS=5

# How long to wait for another process holding the download lock on the volume.
# Default: 7200 (2 hours)
# Sized for the realistic worst case: a second Pod booting while the first is
# still pulling 31.2 GB over a slow link. The lock is an advisory flock, so a
# Pod killed mid-download releases it automatically and never wedges the next
# boot.
#MODEL_LOCK_TIMEOUT_SECONDS=7200


# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------

# Number of GPUs to shard the model across. Default: 1
# This model fits on a single H100 80GB or H200 in FP8, and the fleet scales by
# adding Pods rather than by widening them — one worker per GPU stays
# independently schedulable.
#TENSOR_PARALLEL_SIZE=1

# Opt-in "use every visible GPU". Default: 0
# Honest limitation: the current code path records this flag and shows it in
# the boot banner, but the vLLM argument vector is built from
# TENSOR_PARALLEL_SIZE verbatim. To shard across N GPUs today, set
# TENSOR_PARALLEL_SIZE=N explicitly.
#AUTO_TENSOR_PARALLEL=0

# Which physical GPUs the container may see. Default: unset (all of them).
# Read by the NVIDIA runtime, not by this worker; listed here because it is the
# variable that actually decides what preflight reports.
#CUDA_VISIBLE_DEVICES=0

# Disable the Xet transfer backend for Hugging Face downloads.
# Default: unset (the hub client decides).
# Set to 1 if downloads stall or the Xet CAS endpoint is unreachable from the
# datacentre; the client then falls back to plain HTTPS range requests.
#HF_HUB_DISABLE_XET=1


# ---------------------------------------------------------------------------
# WORKER LIFECYCLE (read by docker/entrypoint.sh, not by config.py)
# ---------------------------------------------------------------------------

# Log the moment the worker becomes able to serve. Default: 0
# When set to 1, entrypoint.sh starts `worker-ready` in the background before
# handing over to vLLM. It is observability only: it cannot fail the container
# and it never delays the handover. The real gate belongs to whatever routes
# traffic — run `ready.sh` from the orchestrator.
#WORKER_WAIT_READY=1

# Skip download and verification entirely. Default: 0
# For offline bootstrap tests of the image ("does the lifecycle run at all
# without a network"). A real Pod started this way makes vLLM resolve the
# repository itself, outside the download lock and outside the volume
# accounting.
#WORKER_SKIP_MODEL_PREPARATION=1

# The base image tag, recorded in the boot banner, in `worker-preflight` and in
# the model marker written to the volume. Default: set by the image to the
# value of the VLLM_IMAGE build argument. Do not override it by hand — a
# marker that claims the wrong runtime is worse than one that claims none.
#VLLM_IMAGE_TAG=vllm/vllm-openai:v0.28.0-cu129


# ---------------------------------------------------------------------------
# SECRETS  —  leave empty here; inject at deploy time
# ---------------------------------------------------------------------------

# Hugging Face token, required only for a gated or private repository.
# Default: unset. HUGGING_FACE_HUB_TOKEN is accepted as an alias.
# Held in a wrapper that refuses to render itself, so it cannot reach a log by
# way of a printed config object.
HF_TOKEN=

# Bearer token clients must present to the OpenAI-compatible API.
# Default: unset — which means the port is OPEN to anything that can reach it.
# On a RunPod Pod with an exposed HTTP port, that is the whole internet. Set it.
# It is redacted from the logged vLLM command line.
VLLM_API_KEY=
